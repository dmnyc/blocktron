# MTA subway stop IDs for your station (southbound only)
# Find yours at https://data.ny.gov/Transportation/MTA-Subway-Stations/39hk-dx4f
SUBWAY_STOP_IDS_S=A16S,226S

# Subway lines to monitor (comma-separated)
SUBWAY_LINES=A,B,C,D

# MTA Bus Time API key (register at https://register.developer.obanyc.com)
BUS_API_KEY=your_key_here

# Bus lines to monitor (comma-separated)
BUS_LINES=M7,M10

# Bus stop IDs (southbound only, numeric MTA Bus Time stop codes)
# Find yours at https://bustime.mta.info/
BUS_STOP_IDS_S=401079,404915
